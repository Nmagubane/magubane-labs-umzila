# Copy to .env for local settings. Blank values fall back to defaults.
PORT=5175
DATABASE_PATH=./data/umzila.db
# open | invite | closed. In invite mode, learners need a class code or one of INVITE_CODES.
SIGNUP_MODE=open
INVITE_CODES=
# Codes that unlock teacher sign-up. Keep them private.
EDUCATOR_CODES=
CONTACT_EMAIL=
PUBLIC_URL=http://localhost:5175
# brevo or resend. Without them, sign-up codes are printed in the server log.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Umzila
